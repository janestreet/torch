   (:include cxx_flags.sexp)))
 (name torch_refcounted_core)
 (public_name torch.refcounted.core)
 (c_library_flags :standard -lstdc++)
 (flags
  :standard
  (:include flags.sexp))
 (foreign_stubs
  (language c)
  (names torch_stubs wrapper_stubs wrapper_generated_refcounted_stubs0
    wrapper_generated_refcounted_stubs1 wrapper_generated_refcounted_stubs2
