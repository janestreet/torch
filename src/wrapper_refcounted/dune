  (extra_deps torch_refcounted_api_generated.h torch_api_for_generated.hpp))
 (libraries core torch_local_iterators torch_refcounted_bindings
   torch_wrapper_types vec)
 (preprocess
  (pps ppx_jane ppx_c_bindings)))

